# docker compose が起動時に読む（.env にコピーして使う。.env はコミットしない）。
# 値を変えると compose.yaml の DATABASE_URL にもそのまま反映される。
POSTGRES_USER=life

# パスワードは DATABASE_URL にそのまま埋め込まれる。@ : / ? # を含めるなら
# percent-encode すること（p@ss なら p%40ss）。生のまま書くと URL の区切りとして
# 解釈され、Postgres 自体は起動するのに api と migrate だけが
# 「ホストが見つからない」系のエラーで落ちる（原因が見えにくい）。
POSTGRES_PASSWORD=life

POSTGRES_DB=life

# ホスト側の公開ポート（コンテナ内は 5432 固定）。
# ローカルの Postgres と衝突するときだけ 5433 などにずらす。
POSTGRES_PORT=5432
